# Copy to .env.local and fill from the Supabase dashboard (Project Settings -> API)
# and 1Password. Mirror these into Railway service variables. NEVER commit real values.

# --- Supabase (client-safe: exposed to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only: service_role key. Railway only, never client-side) ---
# The checker writes check rows with this key, which bypasses RLS. The dashboard
# never uses it — it reads as the signed-in user so RLS stays in force.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Where outage and recovery mail goes. A shared mailbox, so an alert is never
# one person deep. Always send a test to a new address and confirm it shows
# "delivered" in Resend before switching — hello@workwright.co bounced and
ALERT_EMAIL_TO=claude@workwright.co
# Must be on a domain verified in Resend, or sends fail.
ALERT_EMAIL_FROM=Ops Monitor <alerts@workwright.co>

# --- n8n webhook that drops alerts into the Teams channel ---
# Leave blank to disable the Teams half of alerting; email still sends.
N8N_ALERT_WEBHOOK_URL=

# --- WorkWright Portal incident ingest (checker only) ---
# Where a state change is reported so the portal can record it as an incident on
# a hosted client project. Leave both blank to disable: the checker then reports
# nothing and alerting is completely unaffected.
#
# The secret must match MONITOR_INGEST_SECRET on the portal service. A mismatch
# shows up as "portal: HTTP 404 (secret missing or mismatched)" in the checker
# log — the portal answers 404 rather than 401 so an unconfigured endpoint gives
# nothing away.
PORTAL_INCIDENT_URL=https://app.workwright.co/api/monitors/incidents
PORTAL_INCIDENT_SECRET=
