# Copy to .env.local for `npm run check:local`. Secret values come from 1Password;
# the same names are set on the Railway `checker` service. NEVER commit real values.
#
# check:local is a real pass against the PRODUCTION database and sends real email.
# Leave the alert and Teams variables blank to run it without notifying anyone.

# --- Supabase ---
# Project URL. Not a secret; it is the project ref plus .supabase.co.
SUPABASE_URL=https://mgzhjwboinevltuwprxv.supabase.co
# service_role key. Server-only and Railway-only. It bypasses RLS, which is why
# the checker, the only writer, is the only thing that uses it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (alert email) ---
RESEND_API_KEY=
# Where outage and recovery mail goes. An alias, not a person, so on-call can be
# reassigned without a deploy. Send a test to a new address and confirm Resend
# shows it "delivered" before switching: a hard bounce puts the address on
# Resend's suppression list, and every alert after that is dropped silently.
ALERT_EMAIL_TO=monitor@workwright.co
# Must be on a domain verified in Resend, or every send fails.
ALERT_EMAIL_FROM=Ops Monitor <alerts@workwright.co>

# --- Teams ---
# The channel's own email address. Alerts reach Teams by email through Resend,
# with no OAuth token to expire. See docs/decisions.md, 2026-08-14.
TEAMS_CHANNEL_EMAIL=
# Legacy route, used only when TEAMS_CHANNEL_EMAIL is blank and ignored
# otherwise. Kept so unsetting one variable rolls back to the path that was live
# before 2026-08-14.
N8N_ALERT_WEBHOOK_URL=

# --- Second vantage (Cloudflare Worker) ---
# Without the token there is no second opinion: the checker logs "VANTAGE_TOKEN is
# not set" and runs on its own reading alone, which is fine for a local run.
# README, "Deploying the second vantage", covers setting the token on both sides.
VANTAGE_URL=https://ops-monitor-vantage.workwright.workers.dev
VANTAGE_TOKEN=
