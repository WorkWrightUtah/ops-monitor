# Copy to .env.local and fill from the Supabase dashboard (Project Settings -> API)
# and 1Password. Mirror these into Railway service variables. NEVER commit real values.

# --- Supabase (client-safe: exposed to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only: service_role key. Railway only, never client-side) ---
# The checker writes check rows with this key, which bypasses RLS. The dashboard
# never uses it — it reads as the signed-in user so RLS stays in force.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Where outage and recovery mail goes.
ALERT_EMAIL_TO=hello@workwright.co
# Must be on a domain verified in Resend, or sends fail.
ALERT_EMAIL_FROM=Ops Monitor <alerts@workwright.co>

# --- n8n webhook that drops alerts into the Teams channel ---
# Leave blank to disable the Teams half of alerting; email still sends.
N8N_ALERT_WEBHOOK_URL=
